#include <iostream>
#include <string>
#include <cctype>
#include <limits>

using namespace std;

const int MAX_CONTAS = 5;

bool validarCPF(string cpf) {
    string cpfLimpo = "";
    for (char c : cpf) {
        if (isdigit(c)) {
            cpfLimpo += c;
        }
    }

    if (cpfLimpo.length() != 11) return false;

    bool todosIguais = true;
    for (int i = 1; i < 11; i++) {
        if (cpfLimpo[i] != cpfLimpo[0]) {
            todosIguais = false;
            break;
        }
    }
    if (todosIguais) return false;

    int soma = 0;
    for (int i = 0; i < 9; i++) {
        soma += (cpfLimpo[i] - '0') * (10 - i);
    }
    int resto = soma % 11;
    int digito1 = (resto < 2) ? 0 : (11 - resto);

    if (digito1 != (cpfLimpo[9] - '0')) return false;

    soma = 0;
    for (int i = 0; i < 10; i++) {
        soma += (cpfLimpo[i] - '0') * (11 - i);
    }
    resto = soma % 11;
    int digito2 = (resto < 2) ? 0 : (11 - resto);

    if (digito2 != (cpfLimpo[10] - '0')) return false;

    return true;
}

int main() {
    int numeroConta[MAX_CONTAS];
    string nomeCliente[MAX_CONTAS];
    string cpf[MAX_CONTAS];
    int tipoConta[MAX_CONTAS];
    double saldo[MAX_CONTAS];
    bool contaAtiva[MAX_CONTAS];

    for (int i = 0; i < MAX_CONTAS; i++) {
        contaAtiva[i] = false;
        numeroConta[i] = 0;
        saldo[i] = 0.0;
    }

    int opcao = 0;
    int totalCadastradas = 0;

    do {
        cout << "\n====================================\n";
        cout << "           BANCO INF101             \n";
        cout << "====================================\n";
        cout << "1 - Cadastrar conta\n";
        cout << "2 - Consultar conta\n";
        cout << "3 - Verificar saldo\n";
        cout << "4 - Alterar tipo da conta\n";
        cout << "5 - Ativar/Desativar conta\n";
        cout << "6 - Sair\n";
        cout << "Escolha uma opcao: ";
        cin >> opcao;

        switch (opcao) {
            case 1: { 
                if (totalCadastradas >= MAX_CONTAS) {
                    cout << "\n[ERRO] Limite maximo de " << MAX_CONTAS << " contas atingido!\n";
                    break;
                }

                int idx = totalCadastradas;
                cout << "\n--- CADASTRO DE CONTA (Conta " << (idx + 1) << ") ---\n";

                int num;
                do {
                    cout << "Numero da conta (maior que 0): ";
                    cin >> num;
                    if (num <= 0) cout << "[ERRO] O numero da conta deve ser maior que zero!\n";
                } while (num <= 0);
                numeroConta[idx] = num;

                cin.ignore(numeric_limits<streamsize>::max(), '\n');

                cout << "Nome do titular: ";
                getline(cin, nomeCliente[idx]);

                string cpfInput;
                do {
                    cout << "CPF do titular (11 digitos): ";
                    getline(cin, cpfInput);

                    if (!validarCPF(cpfInput)) {
                        cout << "[ERRO] CPF invalido! Digite um CPF valido.\n";
                    }
                } while (!validarCPF(cpfInput));
                cpf[idx] = cpfInput;

                int tipo;
                do {
                    cout << "Tipo de conta (1 - Corrente | 2 - Poupanca): ";
                    cin >> tipo;
                    if (tipo != 1 && tipo != 2) cout << "[ERRO] Tipo invalido! Digite 1 ou 2.\n";
                } while (tipo != 1 && tipo != 2);
                tipoConta[idx] = tipo;

                double s;
                do {
                    cout << "Saldo inicial (nao negativo): R$ ";
                    cin >> s;
                    if (s < 0) cout << "[ERRO] O saldo inicial nao pode ser negativo!\n";
                } while (s < 0);
                saldo[idx] = s;

                contaAtiva[idx] = true;
                totalCadastradas++;

                cout << "\n[SUCESSO] Conta cadastrada com sucesso!\n";
                break;
            }

            case 2: { 
                if (totalCadastradas == 0) {
                    cout << "\n[AVISO] Nenhuma conta cadastrada ate o momento.\n";
                    break;
                }

                int numBusca;
                cout << "\nDigite o numero da conta para consulta: ";
                cin >> numBusca;

                bool encontrada = false;
                for (int i = 0; i < totalCadastradas; i++) {
                    if (numeroConta[i] == numBusca) {
                        encontrada = true;
                        cout << "\n--- DADOS DA CONTA ---\n";
                        cout << "Numero: " << numeroConta[i] << "\n";
                        cout << "Titular: " << nomeCliente[i] << "\n";
                        cout << "CPF: " << cpf[i] << "\n";
                        cout << "Tipo: " << (tipoConta[i] == 1 ? "Corrente" : "Poupanca") << "\n";
                        cout << "Status: " << (contaAtiva[i] ? "Ativa" : "Inativa") << "\n";
                        break;
                    }
                }
                if (!encontrada) {
                    cout << "\n[ERRO] Conta numero " << numBusca << " nao foi encontrada!\n";
                }
                break;
            }

            case 3: { 
                if (totalCadastradas == 0) {
                    cout << "\n[AVISO] Nenhuma conta cadastrada ate o momento.\n";
                    break;
                }

                int numBusca;
                cout << "\nDigite o numero da conta: ";
                cin >> numBusca;

                bool encontrada = false;
                for (int i = 0; i < totalCadastradas; i++) {
                    if (numeroConta[i] == numBusca) {
                        encontrada = true;
                        if (!contaAtiva[i]) {
                            cout << "\n[AVISO] A conta " << numBusca << " esta INATIVA. Operacao nao permitida!\n";
                        } else {
                            cout << "\nSaldo atual da conta " << numeroConta[i] << ": R$ " << saldo[i] << "\n";
                        }
                        break;
                    }
                }
                if (!encontrada) {
                    cout << "\n[ERRO] Conta numero " << numBusca << " nao foi encontrada!\n";
                }
                break;
            }

            case 4: { 
                if (totalCadastradas == 0) {
                    cout << "\n[AVISO] Nenhuma conta cadastrada ate o momento.\n";
                    break;
                }

                int numBusca;
                cout << "\nDigite o numero da conta para alterar o tipo: ";
                cin >> numBusca;

                bool encontrada = false;
                for (int i = 0; i < totalCadastradas; i++) {
                    if (numeroConta[i] == numBusca) {
                        encontrada = true;
                        if (!contaAtiva[i]) {
                            cout << "\n[AVISO] A conta " << numBusca << " esta INATIVA. Operacao nao permitida!\n";
                        } else {
                            int novoTipo;
                            do {
                                cout << "Novo tipo (1 - Corrente | 2 - Poupanca): ";
                                cin >> novoTipo;
                                if (novoTipo != 1 && novoTipo != 2) cout << "[ERRO] Digite 1 ou 2!\n";
                            } while (novoTipo != 1 && novoTipo != 2);

                            tipoConta[i] = novoTipo;
                            cout << "\n[SUCESSO] Tipo de conta alterado para " 
                                 << (novoTipo == 1 ? "Corrente" : "Poupanca") << "!\n";
                        }
                        break;
                    }
                }
                if (!encontrada) {
                    cout << "\n[ERRO] Conta numero " << numBusca << " nao foi encontrada!\n";
                }
                break;
            }

            case 5: { 
                if (totalCadastradas == 0) {
                    cout << "\n[AVISO] Nenhuma conta cadastrada ate o momento.\n";
                    break;
                }

                int numBusca;
                cout << "\nDigite o numero da conta: ";
                cin >> numBusca;

                bool encontrada = false;
                for (int i = 0; i < totalCadastradas; i++) {
                    if (numeroConta[i] == numBusca) {
                        encontrada = true;
                        contaAtiva[i] = !contaAtiva[i];
                        cout << "\n[SUCESSO] O status da conta " << numeroConta[i] 
                             << " mudou para: " << (contaAtiva[i] ? "ATIVA" : "INATIVA") << "\n";
                        break;
                    }
                }
                if (!encontrada) {
                    cout << "\n[ERRO] Conta numero " << numBusca << " nao foi encontrada!\n";
                }
                break;
            }

            case 6:
                cout << "\nSaindo do BANCO INF101... Ate logo!\n";
                break;

            default:
                cout << "\n[ERRO] Opcao invalida! Escolha um numero de 1 a 6.\n";
                break;
        }

    } while (opcao != 6);

    return 0;
}
